# Root-level gitignore for both frontend and backend

# Environment files
.env
.env.*
**/.env
**/.env.*
!**/.env.example
!**/.env.sample

# Python / Django
__pycache__/
**/__pycache__/
*.py[cod]
**/*.py[cod]
*.pyo
**/*.pyo
*.pyd
**/*.pyd
*.sqlite3
**/*.sqlite3
db.sqlite3
**/db.sqlite3
.venv/
**/.venv/
venv/
**/venv/
env/
**/env/
ENV/
**/ENV/
media/
**/media/
staticfiles/
**/staticfiles/
static/
**/static/
.coverage
**/.coverage
.coverage.*
**/.coverage.*
htmlcov/
**/htmlcov/
.pytest_cache/
**/.pytest_cache/

# Node / React
node_modules/
**/node_modules/
build/
**/build/
dist/
**/dist/

# Logs
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

